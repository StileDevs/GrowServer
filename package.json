{
  "name": "growserver",
  "version": "4.0.0",
  "description": "A Growtopia private server built with Bun",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "start:local": "bun run src/index.ts start:local",
    "dev:app": "bun run --watch src/index.ts",
    "dev:caddy": "bun run src/scripts/caddy.ts run --config configs/caddy/Caddyfile.dev",
    "caddy:start": "bun run src/scripts/caddy.ts start --config configs/caddy/Caddyfile.dev",
    "caddy:stop": "bun run src/scripts/caddy.ts stop",
    "dev": "bun run src/scripts/dev.ts",
    "setup": "bun run src/scripts/setup.ts",
    "setup:caddy": "bun run src/scripts/setup.ts --with-caddy",
    "generate:wiki": "bun run src/scripts/generate-wiki.ts",
    "doctor": "bun run src/scripts/doctor.ts",
    "migrate:latest": "bun run src/database/migrator.ts",
    "build": "bun build src/index.ts --target=bun --outdir ./dist",
    "build:assets": "bun run src/scripts/build-assets.ts",
    "compile": "bun build src/index.ts --compile --target=bun --outfile ./dist/growserver",
    "build:compile": "bun run compile"
  },
  "keywords": [],
  "author": "JadlionHD <hendra@jad.li>",
  "contributors": [
    "JadlionHD <hendra@jad.li> (https://github.com/JadlionHD)",
    "badewen (https://github.com/badewen)",
    "GorgonUK (https://github.com/GorgonUK)",
    "Mikasuru (https://github.com/Mikasuru)",
    "dearminder (https://github.com/dearminder)",
    "ZTance1 (https://github.com/ZTance1)",
    "Phoenix-rat (https://github.com/Phoenix-rat)",
    "jeffryafandi (https://github.com/jeffryafandi)",
    "iRestartz (https://github.com/iRestartz)",
    "Ritshu (https://github.com/Ritshu)",
    "sanderDijkxhoorn (https://github.com/sanderDijkxhoorn)",
    "GTPSHAX (https://github.com/GTPSHAX)",
    "Chadgamer2023 (https://github.com/Chadgamer2023)",
    "KalebChristian (https://github.com/KalebChristian)",
    "mario-fuckan (https://github.com/mario-fuckan)",
    "JustPandaEver (https://github.com/JustPandaEver)",
    "swagesh (https://github.com/swagesh)",
    "Roxaro (https://github.com/Roxaro)",
    "Shulej (https://github.com/Shulej)",
    "Willi-js (https://github.com/Willi-js)",
    "Zeeetu (https://github.com/Zeeetu)"
  ],
  "license": "MIT",
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "concurrently": "^10.0.5",
    "dayjs": "^1.11.20",
    "fast-xml-parser": "^5.11.1",
    "grow-items": "^1.3.5",
    "growtopia.wasm": "^0.2.0",
    "hono": "^4.12.19",
    "ky": "^2.0.2",
    "kysely": "^0.29.4",
    "kysely-turso": "^0.1.1",
    "mwparser": "^1.3.3",
    "nanoid": "^5.1.11",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "selfsigned": "^5.5.0",
    "unstorage": "^1.17.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.8.0",
    "typescript": "^7.0.2"
  }
}
